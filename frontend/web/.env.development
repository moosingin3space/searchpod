# The Vite dev server serves this SPA at `/__/frontend/web/`, but the
# backend listens on its own port, so `window.location.origin` is the
# wrong origin in dev. Point the Reboot client at the backend explicitly.
#
# Deliberately no `.env.production`: a production/dist build is served
# by the backend itself, where the `window.location.origin` fallback in
# `main.tsx` is already correct.
VITE_REBOOT_URL=http://localhost:9991
