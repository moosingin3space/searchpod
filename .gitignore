# Reboot dev-server state.
.rbt/

# Generated code; recreated by `rbt generate`.
backend/api/
frontend/api/

# Secrets. Secrets live age-encrypted in `fnox.toml` and are injected by
# `fnox exec --` (see `.rbtrc`); there is no `.env` file. This stays
# ignored so a stray one can never be committed by accident.
.env

# Python virtual environment and caches.
.venv/
__pycache__/
*.py[cod]
.mypy_cache/
.pytest_cache/

# Frontend dependencies and build output (projects with a frontend).
node_modules/
frontend/dist/
